nextflow_workflow {

    name "Test Workflow SCGS"
    script "workflows/scgs.nf"
    workflow "SCGS"

    test("Should run without failures") {

        topics "versions"

        when {
            config "$baseDir/conf/test_denovo.config"
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            workflow {
                """
                // define inputs of the workflow here. Example:
                // input[0] = file("test-file.txt")
                """
            }
        }

        then {
            assert workflow.success
            assert topics.versions.size() > 0
        }

    }

}
