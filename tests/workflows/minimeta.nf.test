nextflow_workflow {

    name "Test Workflow MINIMETA"
    script "workflows/minimeta.nf"
    workflow "MINIMETA"

    test("Should run without failures") {

        topics "versions"

        when {
            config "$baseDir/conf/test_minimeta.config"
            params {
                // define parameters here. Example:
            }
            workflow {
                """
                // define inputs of the workflow here. Example:
                // input[0] = file("test-file.txt")
                """
            }
        }

        then {
            assert workflow.success
            assert topics.versions.size() > 0
        }

    }

    test("Should use imported contigs without assembly") {

        topics "versions"

        when {
            config "$baseDir/conf/test_minimeta.config"
            params {
                ass = false
                fasta = "$baseDir/test-datasets/ATCC25922.fa"
                notrim = 'false'
                single_end = 'false'
                run_cooccurrence_checkm = 'false'
                kofam = 'false'
                eggnog = 'false'
            }
        }

        then {
            assert workflow.success
            assert topics.versions.size() > 0
            assert !topics.versions.any { entry ->
                entry instanceof List && entry[0].toString() =~ /(?:BBNORM|READ_CORRECTION|MERGE_CORRECTED|SPADES_JOINT)/
            }
        }
    }

    test("Rejects invalid boolean text") {
        tag "boolean"
        when {
            config "$baseDir/conf/test_minimeta.config"
            params {
                notrim = 'maybe'
            }
        }

        then {
            assert !workflow.success
            assert workflow.stdout.any { it.contains('--notrim must be true or false') }
        }
    }

}
