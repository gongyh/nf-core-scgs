nextflow_workflow {

    name "Test Workflow PREPARE_DATABASES"
    script "workflows/prepare_databases.nf"
    workflow "PREPARE_DATABASES"

    test("Should run without failures") {

        options "-stub-run"

        topics "versions"

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            workflow {
                """
                // define inputs of the workflow here. Example:
                // input[0] = file("test-file.txt")
                """
            }
        }

        then {
            assert workflow.success
            assert topics.versions.size() > 0
            assert topics.versions.every { file(it).name == "versions.yml" }
            assert topics.versions.every { it.endsWith("/versions.yml") }
        }

    }

}
