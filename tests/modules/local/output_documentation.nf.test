nextflow_process {

    name "Test Process OUTPUT_DOCUMENTATION"
    script "modules/local/output_documentation.nf"
    process "OUTPUT_DOCUMENTATION"

    test("Should run without failures") {

        topics "versions"

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = file("$baseDir/docs/output.md", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert process.out[0].html.get(0) ==~ ".*/results_description.html"
            assert topics.versions.get(0) ==~ ".*/versions.yml"
            def version = path(topics.versions.get(0))
            assert version.text.contains("markdown")
            assert !version.text.contains("END_VERSIONS")
        }

    }

}
