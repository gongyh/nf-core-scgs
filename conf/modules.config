/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per-module execution options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pipeline result publication is declared through workflow outputs.
----------------------------------------------------------------------------------------
*/
process {
    withName: '(^|.*:)MINIMETA:GTDBTK' {
        ext.extension = 'fa'
    }

    withName: 'FASTQC' {
        ext.args = '--quiet'
    }

    withName: 'TRIMGALORE' {
        ext.args = '--fastqc'
    }

    withName: 'BBMAP_ALIGN' {
        ext.args = 'quickmatch fast untrim nodisk minid=0.95 maxindel=3 bwr=0.16 bw=12 minhits=2 qtrim=rl trimq=10'
    }

    withName: 'QUAST_REF' {
        ext.args = '-m 200'
    }

    withName: 'QUAST_DENOVO' {
        ext.args = '-m 200'
    }

    withName: 'BBNORM' {
        ext.args = 'target=100 min=0 ecc=f tossbadreads=t requirebothbad=t'
    }

    withName: 'SPADES|READ_CORRECTION' {
        ext.args = { meta.only_error_correction ? '--only-error-correction' : '' }
    }

    withName: 'GENOMAD_ENDTOEND' {
        ext.when = { params.genomad_db != null }
        ext.args = '--splits 6 --enable-score-calibration --sensitivity 0.1 --disable-nn-classification'
    }

    withName: 'PANTA' {
        ext.when = { params.refs_fna != null }
    }

    withName: 'METABULI_TAXA' {
        ext.args = '--seq-mode 1'
    }

    withName: 'COOCCURRENCE_BINNING' {
        ext.args = '--tsne --tsne_dim 2 --tsne_perplexity 30 --min_samples 5'
    }

    withName: 'FILTER_BAM' {
        stageInMode = 'copy'
    }

    withName: 'FILTER_CONTIGS' {
        stageInMode = 'copy'
    }

    withName: 'TNF_RPKM' {
        stageInMode = 'copy'
    }

    withName: 'FEATURE_FUSION' {
        stageInMode = 'copy'
    }
}
