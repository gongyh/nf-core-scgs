process {
    withName: 'TNF_RPKM' {
        stageInMode = 'copy'
        ext.when = { params.DNABERTS_dir != null }
        publishDir = [
            path: { "${params.outdir}/dcvbin_tnf_rpkm/${meta.id}" },
            mode: 'copy'
