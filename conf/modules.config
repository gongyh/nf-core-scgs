process {
    withName: "MONOVAR" {
        publishDir = [
            path: { "${params.outdir}/monovar" },
            mode: "copy",
            saveAs: { filename ->
                    if (filename.indexOf(".vcf") > 0) "$filename" else null }
        ]
    }
}

process {
  withName: "DOUBLETD" {
      publishDir = [
          path: { "${params.outdir}/doubletd" },
          mode: "copy"
      ]
